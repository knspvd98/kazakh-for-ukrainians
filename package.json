{
  "name": "kazakh-ukrainian-course",
  "version": "1.0.0",
  "description": "Інтерактивний курс казахської мови через українську з уроками, граматикою, словником, фразником та офлайн-аудіо.",
  "private": true,
  "type": "module",
  "author": "knspvd98",
  "license": "UNLICENSED",
  "homepage": "https://knspvd98.github.io/courseforalina/",
  "repository": {
    "type": "git",
    "url": "https://github.com/knspvd98/courseforalina.git"
  },
  "bugs": {
    "url": "https://github.com/knspvd98/courseforalina/issues"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node server/server.mjs",
    "start": "npm run build && npm run serve",
    "qa": "tsx src/qa/runQualityChecks.ts",
    "audio:generate": "tsx scripts/generateStaticAudio.ts",
    "audio:check": "tsx scripts/generateStaticAudio.ts --check",
    "audio:estimate": "tsx scripts/estimateAudio.ts",
    "check": "npm run qa && npm run audio:check && npm run build"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "edge-tts-universal": "^1.4.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  }
}
