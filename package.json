{
  "name": "kazakh-ukrainian-course",
  "version": "1.0.0",
  "description": "An interactive Kazakh course for Ukrainian speakers with lessons, grammar, spaced practice and offline audio.",
  "private": true,
  "type": "module",
  "author": "Dias Konyspayev",
  "license": "UNLICENSED",
  "homepage": "https://knspvd98.github.io/kazakh-for-ukrainians/",
  "repository": {
    "type": "git",
    "url": "https://github.com/knspvd98/kazakh-for-ukrainians.git"
  },
  "bugs": {
    "url": "https://github.com/knspvd98/kazakh-for-ukrainians/issues"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc && vite build",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview --host 127.0.0.1",
    "serve": "node server/server.mjs",
    "start": "npm run build && npm run serve",
    "qa": "tsx src/qa/runQualityChecks.ts",
    "audio:generate": "tsx scripts/generateStaticAudio.ts",
    "audio:check": "tsx scripts/generateStaticAudio.ts --check",
    "audio:estimate": "tsx scripts/estimateAudio.ts",
    "check": "npm run lint && npm run test && npm run qa && npm run audio:check && npm run build"
  },
  "dependencies": {
    "edge-tts-universal": "^1.4.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^26.1.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^28.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
